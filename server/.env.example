MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=buildx
HOST=127.0.0.1
PORT=3001
# Set only to the known number of trusted reverse-proxy hops in production.
# TRUST_PROXY_HOPS=1
# Managed Groq key: server only, never put this in buildx.config.json or renderer files.
GROQ_API_KEY=
# Optional per-section overrides. Blank entries use GROQ_API_KEY above.
GROQ_KEY_GOALS=
GROQ_KEY_MVP_FEATURES=
GROQ_KEY_USER_FLOWS=
GROQ_KEY_SCREENS=
GROQ_KEY_ARCHITECTURE=
GROQ_KEY_DATA_ENTITIES=
GROQ_KEY_API_ENDPOINTS=
GROQ_KEY_IMPLEMENTATION_PHASES=
GROQ_KEY_BUILD_PROMPT=
