{
  "name": "buildx",
  "productName": "BuildX",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop workspace for implementation blueprints",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "ELECTRON_RENDERER_URL=http://127.0.0.1:5173 concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "build": "vite build",
    "start": "npm run build && env -u ELECTRON_RUN_AS_NODE electron .",
    "test:store": "node --test tests/project-store.test.cjs",
    "test:generation": "node --test tests/generation.test.cjs",
    "test:exports": "node --test tests/exports.test.cjs",
    "test:smoke": "npm run build && node scripts/smoke-electron.cjs",
    "test:workspace": "npm run build && node scripts/workspace-electron.cjs",
    "test:export-ui": "npm run build && node scripts/export-electron.cjs",
    "test:live-groq": "node scripts/live-groq.cjs",
    "icon:mac": "node scripts/make-icon.cjs",
    "package:mac": "npm run build && electron-builder --mac dir --arm64",
    "test:package": "node scripts/package-electron.cjs",
    "server:install": "npm install --prefix server",
    "server:start": "npm start --prefix server",
    "test:api": "npm test --prefix server",
    "test:cloud": "node --test tests/cloud-client.test.cjs",
    "test:auth-ui": "npm run build && node scripts/auth-electron.cjs"
  },
  "dependencies": {
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.buildx.desktop",
    "productName": "BuildX",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "package.json",
      "buildx.config.json"
    ],
    "asar": true,
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    }
  }
}
